rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'avatar', 'level', 'xp', 'totalMatches', 'wins']) &&
        data.id is string && data.id == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 24 &&
        data.avatar is string && data.avatar.size() <= 32 &&
        data.level is number && data.level >= 1 &&
        data.xp is number && data.xp >= 0 &&
        data.totalMatches is number && data.totalMatches >= 0 &&
        data.wins is number && data.wins >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'wins', 'level', 'period']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 24 &&
        data.score is number && data.score >= 0 &&
        data.wins is number && data.wins >= 0 &&
        data.level is number && data.level >= 1 &&
        (data.period == 'all_time' || data.period == 'weekly');
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll(['matchId', 'userId', 'score', 'rank', 'character']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.matchId is string && data.matchId.size() <= 128 &&
        data.score is number && data.score >= 0 &&
        data.rank is number && data.rank >= 1 && data.rank <= 8 &&
        data.character is string && data.character.size() <= 32;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) &&
        request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    // Collection: /leaderboard/{entryId}
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(request.resource.data) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // Collection: /matches/{matchId}
    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatchRecord(request.resource.data);
      allow update, delete: if false;
    }
  }
}
